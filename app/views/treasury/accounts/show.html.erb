<div id="flash" class="fixed top-4 right-4 z-50 space-y-2 max-w-md w-full">
  <% flash.each do |type, content| %>
    <% is_notice = type.to_s == "notice" %>
    <% bg_color = is_notice ? "bg-emerald-50 text-emerald-900 border-emerald-200" : "bg-red-50 text-red-900 border-red-200" %>

    <div class="p-4 rounded-lg border shadow-md <%= bg_color %>" data-controller="removable">
      <div class="flex items-start justify-between">
        <div class="space-y-1">
          <% if content.is_a?(Hash) %>
            <p class="text-sm font-semibold"><%= content[:title] || content["title"] %></p>
            <% if (errs = content[:errors] || content["errors"]).present? %>
              <ul class="mt-1.5 list-disc list-inside text-xs space-y-1 opacity-90">
                <% Array(errs).each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            <% end %>
          <% else %>
            <p class="text-sm font-medium"><%= content %></p>
          <% end %>
        </div>

        <button type="button" class="ml-4 text-gray-400 hover:text-gray-600 focus:outline-none shrink-0" onclick="this.closest('[data-controller]').remove()">
          <span class="sr-only">Close</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  <% end %>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Account: <%= @account.account_number %></h1>
      <p class="text-sm text-gray-600"><%= @account.business_unit %></p>
    </div>
    <div>
      <%= link_to "Upload Statement", new_treasury_account_statement_import_path(@account), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <!-- Date Range Filter Form -->
  <div class="bg-white shadow sm:rounded-lg p-4 mb-6">
    <%= form_with url: treasury_account_path(@account), method: :get, local: true, class: "flex items-end space-x-4" do |f| %>
      <div>
        <label class="block text-xs font-medium text-gray-700 uppercase">From Date</label>
        <%= date_field_tag :from_date, @from_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 uppercase">To Date</label>
        <%= date_field_tag :to_date, @to_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.submit "Filter Period", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500" %>
      </div>
    <% end %>
  </div>

  <!-- Balance Summaries per Currency -->
  <% if @balance_summaries.any? %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 mb-8">
      <% @balance_summaries.each do |summary| %>
        <div class="bg-white overflow-hidden shadow rounded-lg p-5">
          <div class="text-sm font-medium text-gray-500 truncate">Currency: <%= summary[:currency] %></div>
          <div class="mt-1 text-3xl font-semibold text-gray-900"><%= summary[:closing_balance].format %></div>
          <div class="mt-4 text-xs text-gray-600 space-y-1">
            <div class="flex justify-between"><span>Opening:</span> <span class="font-medium"><%= summary[:opening_balance].format %></span></div>
            <div class="flex justify-between"><span>Net Period Movement:</span> <span class="font-medium"><%= summary[:period_net_movement].format %></span></div>
            <div class="flex justify-between border-t pt-1"><span>Reconciled Lines:</span> <span class="font-medium"><%= summary[:reconciled_count] %></span></div>
            <div class="flex justify-between"><span>Duplicates Excluded:</span> <span class="font-medium"><%= summary[:excluded_duplicates_count] %></span></div>
            <div class="flex justify-between"><span>Reversals:</span> <span class="font-medium"><%= summary[:reversals_count] %></span></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Movements Table -->
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Reconciled Movements</h3>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Posting Timestamp</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @movements.any? %>
          <% @movements.each do |movement| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= movement.posting_ts.strftime("%Y-%m-%d %H:%M:%S UTC") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= movement.description %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= movement.category %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-semibold <%= movement.amount_cents.negative? ? 'text-red-600' : 'text-green-600' %>">
                <%= Money.new(movement.amount_cents, movement.currency).format(sign_before_symbol: true) %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-6 py-8 text-center text-sm text-gray-500">
              No movements found for this date range.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
